# GPU build for AWS (g4dn / g5 etc.). Needs the NVIDIA driver + container toolkit on the host,
# and `docker run --gpus all` (or `deploy.resources.reservations.devices` in compose).
# The CPU-only Dockerfile.python is unchanged and is still the right choice without a GPU.
FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# torch/torchvision already ship in the base image with CUDA support.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Auto-detects CUDA; set YOLO_DEVICE to force a device (e.g. cuda:0 or cpu).
EXPOSE 8000
CMD ["python", "scripts/live_server.py"]
